# Copy file này thành .env và điền giá trị thật

# Flask secret — KHÔNG để trống trong production. Sinh bằng:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Nếu trống: app sẽ dùng random key, sessions invalidate mỗi lần restart server.
FLASK_SECRET=

# OAuth token encryption key (dedicated). Ưu tiên dùng key riêng để rotate
# độc lập với FLASK_SECRET (session cookie). Sinh bằng:
#   python -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Nếu trống: fallback derive từ FLASK_SECRET qua HKDF-SHA256 (vẫn an toàn,
# nhưng key reuse cross-context).
TOKEN_ENCRYPTION_KEY=

# Dev-only: chạy app qua HTTP localhost (không SSL). Mặc định OFF — session
# cookie có cờ Secure, browser CHỈ gửi cookie qua HTTPS. Bật khi local debug
# không có cert (vd: chỉ test rule-based NLU).
FLASK_DEV_HTTP=false

# Gemini API key (lấy free tại https://aistudio.google.com/apikey)
# Nếu bỏ trống → tự fallback sang rule-based NLU
GEMINI_API_KEY=

# =============================================================
# ASR backend
# =============================================================
# "faster-whisper" (default, CT2 quantized, nhanh trên CPU int8)
# "phowhisper"    (vinai/PhoWhisper-*, fine-tune VN, cần `pip install transformers`)
ASR_BACKEND=faster-whisper

# faster-whisper config
WHISPER_MODEL=base         # tiny / base / small / medium / large-v3 (base nhanh trên CPU int8)
WHISPER_DEVICE=cpu         # cpu / cuda
WHISPER_COMPUTE=int8       # int8 cho CPU, float16 hoặc float32 cho GPU

# PhoWhisper config (chỉ dùng khi ASR_BACKEND=phowhisper)
PHOWHISPER_MODEL=vinai/PhoWhisper-base   # base / small / medium / large
PHOWHISPER_DEVICE=                       # rỗng = auto (cuda → cpu)

# Sửa transcript bằng Gemini (eager mode, mọi turn).
# false (mặc định) → vẫn dùng correction nhưng CHỈ khi NLU=unknown (parse_with_correction).
ASR_CORRECT=false

# =============================================================
# Speaker backend
# =============================================================
# "ecapa" (default): ECAPA-TDNN — own checkpoint (Tuần 1) hoặc pretrained SpeechBrain
# "wavlm"          : microsoft/wavlm-base-plus-sv — cần `pip install transformers`
SPEAKER_BACKEND=ecapa

# ECAPA checkpoint (từ Tuần 1).
# Nếu file không tồn tại → tự fallback sang pretrained SpeechBrain (VoxCeleb2).
SPEAKER_CKPT=./checkpoints/best_model.pt

# WavLM config (chỉ dùng khi SPEAKER_BACKEND=wavlm)
WAVLM_MODEL=microsoft/wavlm-base-plus-sv
WAVLM_DEVICE=                            # rỗng = auto

# Thresholds — calibrate lại cho dataset/môi trường của bạn.
# Các value default đã calibrate trên 5 user × 5 audio nội bộ.
SV_THRESHOLD_OWN=0.45                    # ECAPA own checkpoint
SV_THRESHOLD_PRETRAINED=0.25             # SpeechBrain pretrained
SV_THRESHOLD_WAVLM=0.93                  # WavLM (score concentrate cao)

SID_MIN_THRESHOLD_OWN=0.35
SID_MIN_THRESHOLD_PRETRAINED=0.20
SID_MIN_THRESHOLD_WAVLM=0.90

# Top-1 vs top-2 margin: chống claim user khi 2 user có score gần ngang nhau
SID_MIN_MARGIN=0.08

# =============================================================
# Speaker pipeline knobs (đều có default an toàn, có thể giữ nguyên)
# =============================================================
# Multi-window: chia audio dài → N cửa sổ → average embedding (robust hơn)
SPEAKER_MULTIWINDOW=true
SPEAKER_WINDOW_SEC=2.0
SPEAKER_N_WINDOWS=3

# AS-Norm-lite: z-normalize raw cosine theo cohort các user khác.
# Auto-disable nếu cohort < SPEAKER_ASNORM_MIN_COHORT.
SPEAKER_ASNORM=true
SPEAKER_ASNORM_MIN_COHORT=4
SPEAKER_ASNORM_TOP_K=5
SPEAKER_ASNORM_Z_THRESHOLD=2.0

# Audio preprocessing trước encode. CHÚ Ý: đổi sau khi enroll → re-enroll
# user (scripts/reenroll_backend.py) để centroid khớp domain mới.
SPEAKER_PREPROCESS=false                 # DC-removal + RMS-normalize
SPEAKER_DENOISE=false                    # spectral gating (cần `pip install noisereduce`)

# Enroll defaults
ENROLL_DURATION=5.0                      # giây mỗi mẫu
ENROLL_NUM_SAMPLES=5                     # số mẫu mỗi user

# =============================================================
# Google OAuth 2.0 — Gmail API (thay thế SMTP App Password)
# =============================================================
# 1. Vào https://console.cloud.google.com → tạo project mới
# 2. APIs & Services → Enable "Gmail API"
# 3. OAuth consent screen → External → điền tên app → Add scope:
#      https://www.googleapis.com/auth/gmail.send
# 4. Credentials → Create OAuth client ID → Web application
#    Authorized redirect URI: http://localhost:5000/auth/google/callback
# 5. Tải JSON → lấy client_id và client_secret dán vào đây
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Phải khớp chính xác với URI trong Google Cloud Console
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback

# Admin panel
ADMIN_PASS=

# =============================================================
# Auth policy
# =============================================================
# Text-mode IMPORTANT: cho phép password thay Speaker Verification.
# Mặc định false — text-mode block IMPORTANT outright; chỉ voice mới qua SV gate.
# Đặt true khi cần demo flow IMPORTANT không có mic, HOẶC khi muốn cho phép
# password fallback chính thức.
# CẢNH BÁO: password KHÔNG phải biometric — chỉ là "know factor".
# Document rõ trong threat model của báo cáo.
ALLOW_PASSWORD_FOR_IMPORTANT=false

# Challenge-response: sau khi SID+SV pass cho IMPORTANT, yêu cầu user đọc
# lại 1 phrase random ngắn (vd "ba bốn năm sáu"). Server verify ASR-match +
# SV trên audio thứ 2. Chống replay attack đơn giản.
# Mặc định false (demo nhanh hơn); bật khi báo cáo bảo mật cần highlight.
CHALLENGE_RESPONSE_ENABLED=false
CHALLENGE_PHRASE_LEN=4

# Incremental re-enroll: sau khi SV pass, cập nhật centroid 1 ít theo audio
# mới — chống speaker drift do tuổi/mic/nhiễu thay đổi theo thời gian.
# alpha nhỏ (0.05-0.15) khuyến nghị; quá lớn → centroid drift theo nhiễu.
SPEAKER_INCREMENTAL_REENROLL=false
SPEAKER_INCREMENTAL_ALPHA=0.1

# Encrypt biometric WAV at-rest: lưu `data/enroll_audio/*.wav.enc` (Fernet)
# thay vì plaintext WAV. Cần TOKEN_ENCRYPTION_KEY (hoặc FLASK_SECRET fallback).
# Bật cho production / khi backup filesystem có thể bị lộ. Mặc định OFF —
# bật cần migration cho file đã có (chạy scripts/encrypt_existing_wavs.py
# nếu có, hoặc reenroll-voice cho từng user).
ENCRYPT_BIOMETRIC_WAV=false
